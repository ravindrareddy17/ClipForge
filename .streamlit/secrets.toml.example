# Streamlit Community Cloud Secrets Template
# In Streamlit Cloud dashboard: App Settings -> Secrets -> Paste your keys:

LLM_PROVIDER = "groq" # Options: groq, gemini, ollama

# Groq Cloud API (Get key from https://console.groq.com/keys)
GROQ_API_KEY = "gsk_your_groq_api_key_here"
GROQ_MODEL = "openai/gpt-oss-20b"

# Google Gemini API (Get key from https://aistudio.google.com/app/apikey)
GEMINI_API_KEY = "your_gemini_api_key_here"
GEMINI_MODEL = "gemini-3.6-flash"

# Local Ollama Configuration (For local development)
OLLAMA_URL = "http://localhost:11434"
OLLAMA_MODEL = "qwen2.5:3b"
OLLAMA_EMBEDDING_MODEL = "nomic-embed-text"
